---
export interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={`illu-lamp ${className}`} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
	<ellipse cx="24" cy="40" rx="16" ry="5" fill="var(--illu-fill, transparent)" stroke="currentColor" stroke-width="2"></ellipse>
	<line x1="24" y1="36" x2="24" y2="12" stroke="currentColor" stroke-width="2"></line>
	<path d="M17,12 L24,4 L31,12 Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="var(--accent-3)" opacity="0.9"></path>
	<circle cx="24" cy="12" r="2" fill="currentColor"></circle>
</svg>
