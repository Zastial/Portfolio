---
import { Icon } from 'astro-icon/components';
import LanguagePicker from './LanguagePicker.astro';
import profileImage from '../assets/profile.webp';
import githubProfileImage from '../assets/github-profile.webp';
import { useTranslations } from '../i18n/utils';
import { getPortfolioContent } from '../data/portfolio';

export interface Props {
	lang: 'fr' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const content = getPortfolioContent(lang);
const resumeHref = lang === 'fr' ? '/CV_AlexandreCAROL.pdf' : '/Resume_AlexandreCAROL.pdf';
---

<main class="portfolio-page">
	<div class="section-arrows" aria-label={t('aria.sectionNavigation')}>
		<button type="button" class="section-arrow section-arrow-left" data-prev-section aria-label={t('aria.previousSection')}>
			<span aria-hidden="true">&#8592;</span>
		</button>
		<button type="button" class="section-arrow section-arrow-right" data-next-section aria-label={t('aria.nextSection')}>
			<span aria-hidden="true">&#8594;</span>
		</button>
	</div>

	<nav class="topbar" aria-label={t('aria.mainNav')}>
		<a class="brand" href="#accueil" aria-label={t('aria.backToTop')}>
			<img class="brand-mark" src={githubProfileImage.src} alt={`Photo de ${content.profile.name}`} />
			<span>
				<strong>{content.profile.name}</strong>
				<small>{t('profile.role')}</small>
			</span>
		</a>

		<div class="topbar-actions">
			<button
				type="button"
				class="nav-toggle"
				data-nav-toggle
				aria-expanded="false"
				aria-controls="header-nav"
				aria-label={t('aria.openMenu')}
			>
				<span></span>
				<span></span>
				<span></span>
			</button>

			<div aria-label={t('aria.mainNav')} class="nav" id="header-nav">
				<a href="#accueil">{t('nav.home')}</a>
				<a href="#competences">{t('nav.skills')}</a>
				<a href="#experience">{t('nav.experience')}</a>
				<a href="#formation">{t('nav.education')}</a>
				<a href="#projets">{t('nav.projects')}</a>
				<a href="#contact">{t('nav.contact')}</a>
			</div>

			<LanguagePicker />

			<button
				type="button"
				class="theme-toggle"
				data-theme-toggle
				aria-pressed="false"
				aria-label={t('aria.darkTheme')}
			>
				<Icon name="mdi:weather-sunny" class="theme-icon theme-icon-sun" aria-hidden="true" />
				<Icon name="mdi:weather-night" class="theme-icon theme-icon-moon" aria-hidden="true" />
			</button>
		</div>
	</nav>

	<section class="hero" id="accueil">
		<div class="hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">{t('hero.eyebrow')}</p>
				<div class="hero-name-row">
					<span class="hero-avatar-wrap">
						<img class="hero-avatar" src={profileImage.src} alt={`Photo de ${content.profile.name}`} />
					</span>
					<h1>{content.profile.name}</h1>
				</div>
				<p class="lede">{content.profile.intro}</p>

				<div class="hero-actions">
					<a class="button button-primary" href="#projets">{t('hero.seeProjects')}</a>
					<a class="button button-secondary" href="#contact">{t('hero.contactMe')}</a>
					<a class="button button-secondary" href={resumeHref} download aria-label={t('aria.downloadResume')}>{t('hero.downloadResume')}</a>
				</div>

				<ul class="stats" aria-label={t('aria.keyPoints')}>
					{content.stats.map((stat: any) => (
						<li>
							<strong>{stat.value}</strong>
							<span>{stat.label}</span>
						</li>
					))}
				</ul>
			</div>

			<aside class="hero-panel" aria-label={t('aria.profileSummary')}>
				<div class="panel-chip">{content.profile.location}</div>
				<div class="panel-chip">{t('profile.openToOpportunities')}</div>
				<h2>{t('profile.availability')}</h2>

				<div class="panel-list">
					<a class="panel-link-card" href={`mailto:${content.profile.email}`}>
						<span>Email</span>
						<strong>{content.profile.email}</strong>
					</a>
					{content.profile.links.map((link) => (
						<a class="panel-link-card" href={link.href} target="_blank" rel="noreferrer">
							<span>{link.label}</span>
							<strong>{link.href.replace('https://', '').replace('http://', '')}</strong>
						</a>
					))}
				</div>
			</aside>
		</div>
	</section>

	<section class="section" id="competences">
		<div class="section-heading">
			<p class="eyebrow">{t('section.skills.eyebrow')}</p>
			<h2>{t('section.skills.title')}</h2>
			<p>{t('section.skills.lead')}</p>
		</div>

		<div class="skills-grid">
			{content.skills.map((group) => (
				<article class="feature-card">
					<h3>{group.title}</h3>
					<ul class="chip-list" aria-label={group.title}>
						{group.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</section>

	<section class="section" id="experience">
		<div class="section-heading">
			<p class="eyebrow">{t('section.experience.eyebrow')}</p>
			<h2>{t('section.experience.title')}</h2>
			<p>{t('section.experience.lead')}</p>
		</div>

		<div class="history-list">
			{content.experiences.map((item) => (
				<article class="history-item">
					<div>
						<span>{item.meta}</span>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="section split" id="formation">
		<div>
			<div class="section-heading">
				<p class="eyebrow">{t('section.education.eyebrow')}</p>
				<h2>{t('section.education.title')}</h2>
				<p>{t('section.education.lead')}</p>
			</div>

			<div class="timeline">
				{content.education.map((item) => (
					<article class="timeline-card">
						<h3>{item.title}</h3>
						<span>{item.meta}</span>
						<p>{item.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section" id="projets">
		<div class="section-heading section-heading-inline">
			<div>
				<p class="eyebrow">{t('section.projects.eyebrow')}</p>
				<h2>{t('section.projects.title')}</h2>
			</div>
		</div>

		<div class="filter-bar" role="tablist" aria-label={t('aria.projectsFilter')}>
			{content.projectFilters.map((filter, index) => (
				<button
					type="button"
					class:list={{ 'is-active': index === 0 }}
					data-filter-value={filter.value}
					aria-pressed={index === 0 ? 'true' : 'false'}
				>
					{filter.label}
				</button>
			))}
		</div>

		<div class="project-grid">
			{content.projects.map((project) => (
				<article class="project-card" data-project-card data-tags={project.tags.join(' ')}>
					<div class="project-card-head">
						<span>{project.categoryLabel}</span>
						<time>{project.year}</time>
					</div>
					<h3>{project.name}</h3>
					<div class="project-description-paragraphs">
						{project.description.map((line) => (
							<p>{line}</p>
						))}
					</div>

					<ul class="stack-list" aria-label={`${t('aria.projectStackPrefix')} ${project.name}`}>
						{project.stack.map((item) => (
							<li>{item}</li>
						))}
					</ul>

					<div class="project-foot">
						<strong>{project.impact}</strong>
						{project.linkHref && project.linkLabel && (
							<a href={project.linkHref} target={project.linkHref.startsWith('http') ? '_blank' : undefined} rel={project.linkHref.startsWith('http') ? 'noreferrer' : undefined}>
								{project.linkLabel}
							</a>
						)}
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="section contact-card" id="contact">
		<div>
			<p class="eyebrow">{t('section.contact.eyebrow')}</p>
			<h2>{t('section.contact.title')}</h2>
		</div>

		<div class="contact-actions">
			<a class="button button-primary" href={`mailto:${content.profile.email}`}>{content.profile.email}</a>
			<a class="button button-secondary" href={content.profile.links[0].href} target="_blank" rel="noreferrer">
				LinkedIn
			</a>
			<a class="button button-secondary" href={content.profile.links[1].href} target="_blank" rel="noreferrer">
				GitHub
			</a>
		</div>
	</section>
</main>

<script
	define:vars={{
		navOpenLabel: t('aria.openMenu'),
		navCloseLabel: t('aria.closeMenu'),
		themeToDarkLabel: t('aria.darkTheme'),
		themeToLightLabel: t('aria.lightTheme'),
	}}
>
	const themeToggle = document.querySelector('[data-theme-toggle]');
	const navToggle = document.querySelector('[data-nav-toggle]');
	const headerNav = document.querySelector('#header-nav');
	const prevSectionButton = document.querySelector('[data-prev-section]');
	const nextSectionButton = document.querySelector('[data-next-section]');
	const filterButtons = Array.from(document.querySelectorAll('[data-filter-value]'));
	const projectCards = Array.from(document.querySelectorAll('[data-project-card]'));
	const visibleCount = document.querySelector('[data-visible-count]');
	const themeMeta = document.querySelector('meta[name="theme-color"]');
	const orderedSections = Array.from(document.querySelectorAll('main section[id]'));
	let currentSectionId = orderedSections[0]?.id ?? 'accueil';
	const sectionScrollOffset = 64;
	const navLinks = Array.from(document.querySelectorAll('#header-nav a[href^="#"]'));
	const brandLink = document.querySelector('.brand[href^="#"]');

	const setNavOpen = (isOpen) => {
		if (!navToggle || !headerNav) {
			return;
		}

		navToggle.setAttribute('aria-expanded', String(isOpen));
		navToggle.setAttribute('aria-label', isOpen ? navCloseLabel : navOpenLabel);
		headerNav.classList.toggle('is-open', isOpen);
	};

	const applyTheme = (theme) => {
        document.documentElement.classList.add('theme-switching');
        
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        localStorage.setItem('theme', theme);
        
        if (themeToggle) {
            themeToggle.setAttribute('aria-pressed', String(theme === 'dark'));
            themeToggle.setAttribute('aria-label', theme === 'dark' ? themeToLightLabel : themeToDarkLabel);
        }
        if (themeMeta) {
            themeMeta.setAttribute('content', theme === 'dark' ? '#081120' : '#f5f1ea');
        }

        requestAnimationFrame(() => {
            document.documentElement.classList.remove('theme-switching');
        });
    };
	if (themeToggle) {
		themeToggle.addEventListener('click', () => {
			const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			applyTheme(nextTheme);
		});
	}

	const scrollToSectionId = (sectionId, updateHash = true) => {
		const target = orderedSections.find((section) => section.id === sectionId);
		if (!target) {
			return;
		}

		const targetTop = target.getBoundingClientRect().top + window.scrollY - sectionScrollOffset;
		window.scrollTo({
			top: Math.max(0, targetTop),
			behavior: 'smooth',
		});

		currentSectionId = target.id;
		updateArrowState();

		if (updateHash) {
			history.pushState(null, '', `#${target.id}`);
		}
	};

	navLinks.forEach((link) => {
		link.addEventListener('click', (event) => {
			const targetId = link.getAttribute('href')?.replace('#', '');
			if (!targetId) {
				return;
			}

			event.preventDefault();
			scrollToSectionId(targetId);
			setNavOpen(false);
		});
	});

	if (brandLink) {
		brandLink.addEventListener('click', (event) => {
			const targetId = brandLink.getAttribute('href')?.replace('#', '');
			if (!targetId) {
				return;
			}

			event.preventDefault();
			scrollToSectionId(targetId);
		});
	}

	if (navToggle && headerNav) {
		navToggle.addEventListener('click', () => {
			const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
			setNavOpen(!isOpen);
		});

		window.addEventListener('resize', () => {
			if (window.innerWidth > 980) {
				setNavOpen(false);
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				setNavOpen(false);
			}
		});
	}

	const setFilter = (value) => {
		let count = 0;

		projectCards.forEach((card) => {
			const tags = (card.dataset.tags ?? '').split(' ').filter(Boolean);
			const shouldShow = value === 'all' || tags.includes(value);

			card.hidden = !shouldShow;

			if (shouldShow) {
				count += 1;
			}
		});

		filterButtons.forEach((button) => {
			const isActive = button.dataset.filterValue === value;
			button.classList.toggle('is-active', isActive);
			button.setAttribute('aria-pressed', String(isActive));
		});

		if (visibleCount) {
			visibleCount.textContent = String(count);
		}
	};

	filterButtons.forEach((button) => {
		button.addEventListener('click', () => {
			setFilter(button.dataset.filterValue ?? 'all');
		});
	});

	const updateArrowState = () => {
		if (!orderedSections.length || !prevSectionButton || !nextSectionButton) {
			return;
		}

		const currentIndex = orderedSections.findIndex((section) => section.id === currentSectionId);
		const atStart = currentIndex <= 0;
		const atEnd = currentIndex === orderedSections.length - 1;

		prevSectionButton.disabled = atStart;
		nextSectionButton.disabled = atEnd;
	};

	const goToSectionByOffset = (offset) => {
		if (!orderedSections.length) {
			return;
		}

		const currentIndex = orderedSections.findIndex((section) => section.id === currentSectionId);
		const safeCurrentIndex = currentIndex === -1 ? 0 : currentIndex;
		const nextIndex = Math.min(Math.max(safeCurrentIndex + offset, 0), orderedSections.length - 1);
		const target = orderedSections[nextIndex];
		scrollToSectionId(target.id);
	};

	if (prevSectionButton && nextSectionButton && orderedSections.length) {
		prevSectionButton.addEventListener('click', () => {
			goToSectionByOffset(-1);
		});

		nextSectionButton.addEventListener('click', () => {
			goToSectionByOffset(1);
		});

		const observer = new IntersectionObserver(
			(entries) => {
				const visibleEntries = entries
					.filter((entry) => entry.isIntersecting)
					.sort((a, b) => b.intersectionRatio - a.intersectionRatio);

				if (!visibleEntries.length) {
					return;
				}

				const topEntry = visibleEntries[0];
				if (topEntry.target instanceof HTMLElement) {
					currentSectionId = topEntry.target.id;
					updateArrowState();
				}
			},
			{ threshold: [0.45, 0.7] },
		);

		orderedSections.forEach((section) => {
			observer.observe(section);
		});

		window.addEventListener('hashchange', () => {
			const hash = window.location.hash.replace('#', '');
			if (!hash) {
				return;
			}

			currentSectionId = hash;
			updateArrowState();
		});

		updateArrowState();
	}

	setFilter('all');
	applyTheme(document.documentElement.dataset.theme ?? 'light');
</script>

<style>
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.portfolio-page {
		width: min(1160px, calc(100% - 32px));
		margin: 0 auto;
		padding: 16px 0 72px;
	}

	.section-arrows {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 30;
	}

	.section-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		pointer-events: auto;
		width: 48px;
		height: 48px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
		box-shadow: var(--shadow);
		font-size: 1.35rem;
		cursor: pointer;
		transition: transform 180ms ease, opacity 180ms ease;
	}

	.section-arrow-left {
		left: 14px;
	}

	.section-arrow-right {
		right: 14px;
	}

	.section-arrow:hover,
	.section-arrow:focus-visible {
		transform: translateY(-50%) scale(1.05);
		background: var(--surface-strong);
		border-color: var(--border-strong);
	}

	.section-arrow:disabled {
		opacity: 0.35;
		cursor: not-allowed;
		transform: translateY(-50%);
	}

	.hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
        margin-top: 2rem;
		animation: fadeInUp 600ms ease-out 0.1s both;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		position: sticky;
		top: 10px;
		z-index: 40;
		padding: 10px 14px;
		border-radius: 18px;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--surface-strong) 84%, transparent);
		backdrop-filter: blur(12px);
	}

	.topbar-actions {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		position: relative;
	}

	.nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		gap: 4px;
		flex-direction: column;
		padding: 0;
		width: 46px;
		height: 46px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
		cursor: pointer;
		box-shadow: var(--shadow);
	}

	.nav-toggle span {
		display: block;
		width: 16px;
		height: 2px;
		border-radius: 99px;
		background: currentColor;
		transition: transform 220ms ease, opacity 220ms ease;
	}

	.nav-toggle[aria-expanded='true'] span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}

	.nav-toggle[aria-expanded='true'] span:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle[aria-expanded='true'] span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		color: var(--text);
	}

	.brand strong {
		display: block;
		font-size: 1rem;
	}

	.brand small {
		display: block;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 18px;
		background: linear-gradient(135deg, rgba(120, 228, 255, 0.18), rgba(243, 167, 255, 0.18));
		border: 1px solid var(--border);
		box-shadow: var(--shadow);
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.nav {
		display: inline-flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 10px;
	}

	.nav a {
		padding: 10px 14px;
		border-radius: 999px;
		border: 1px solid transparent;
		color: var(--muted);
		transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, color 180ms ease;
	}

	.nav a:hover,
	.nav a:focus-visible {
		transform: translateY(-1px);
		border-color: var(--border);
		background: rgba(255, 255, 255, 0.03);
		color: var(--text);
	}

	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		position: relative;
		padding: 0;
		width: 46px;
		height: 46px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
		cursor: pointer;
		box-shadow: var(--shadow);
		transition: background-color 320ms ease, color 320ms ease, border-color 320ms ease, box-shadow 320ms ease, transform 220ms ease;
	}

	.theme-toggle:hover,
	.theme-toggle:focus-visible {
		transform: translateY(-1px);
	}

	.theme-icon {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 18px;
		height: 18px;
		transform: translate(-50%, -50%) scale(1);
		transition: opacity 320ms ease, transform 320ms ease;
	}

	.theme-icon-moon {
		opacity: 0;
		transform: translate(-50%, -50%) scale(0.86);
	}

	:root[data-theme='dark'] .theme-icon-sun {
		opacity: 0;
		transform: translate(-50%, -50%) scale(0.86);
	}

	:root[data-theme='dark'] .theme-icon-moon {
		opacity: 1;
		transform: translate(-50%, -50%) scale(1);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(250px, 0.8fr);
		gap: 18px;
		align-items: stretch;
	}

	.hero-copy,
	.hero-panel,
	.feature-card,
	.project-card,
	.timeline-card,
	.history-item,
	.contact-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 28px;
		box-shadow: var(--shadow);
		backdrop-filter: blur(18px);
		transition: border-color 320ms ease, box-shadow 320ms ease, transform 320ms ease;
	}

	.hero-copy {
		padding: clamp(24px, 4vw, 36px);
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 18px;
		color: var(--accent-3);
		font-size: 0.88rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.18em;
	}

	.hero h1 {
		max-width: 10ch;
		font-size: clamp(2.8rem, 6.2vw, 5.6rem);
		line-height: 0.92;
	}

	.hero-name-row {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.hero-avatar-wrap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: clamp(100px, 17vw, 150px);
		height: clamp(100px, 17vw, 150px);
