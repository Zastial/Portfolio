---
// Ambient decorative backdrop: drifting stars and a desert/night horizon line.
// Purely decorative — sits fixed behind all content, ignores pointer events, hidden from AT.
const STAR_COUNT = 44;
const stars = Array.from({ length: STAR_COUNT }, (_, i) => {
	const seed = i * 137.5; // golden-angle spread avoids visible grid patterns
	const x = Math.round(((Math.sin(seed) + 1) / 2) * 1000) / 10;
	const y = Math.round(((Math.cos(seed * 1.3) + 1) / 2) * 1000) / 10;
	const size = Math.round((1 + ((i * 37) % 5) * 0.5) * 10) / 10;
	const delay = Math.round(((i * 53) % 60) * 10) / 10;
	const duration = 3 + ((i * 19) % 5);
	return { x, y, size, delay, duration };
});
---

<div class="sky" aria-hidden="true">
	<div class="stars">
		{stars.map((star) => (
			<span
				class="star"
				style={`--x:${star.x}%; --y:${star.y}%; --size:${star.size}px; --delay:${star.delay}s; --duration:${star.duration}s;`}
			></span>
		))}
	</div>

	<svg class="horizon" viewBox="0 0 1440 220" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
		<path
			d="M0,140 C180,90 300,170 480,130 C660,90 760,160 940,120 C1120,80 1260,150 1440,110 L1440,220 L0,220 Z"
			class="dune dune-back"
		></path>
		<path
			d="M0,180 C220,130 340,190 560,160 C780,130 900,185 1100,150 C1260,124 1350,170 1440,150 L1440,220 L0,220 Z"
			class="dune dune-front"
		></path>
	</svg>

	<img class="prince-bg" src="/petitPrince.png" alt="" />
</div>

<style>
	.sky {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}

	.stars {
		position: absolute;
		inset: 0;
		opacity: var(--stars-opacity, 0.35);
		transition: opacity 420ms ease;
	}

	.star {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: var(--size);
		height: var(--size);
		border-radius: 50%;
		background: var(--star-color, #fff);
		box-shadow: 0 0 6px 1px var(--star-color, #fff);
		animation: twinkle var(--duration) ease-in-out var(--delay) infinite;
	}

	@keyframes twinkle {
		0%,
		100% {
			opacity: 0.15;
			transform: scale(0.8);
		}
		50% {
			opacity: 1;
			transform: scale(1.15);
		}
	}

	.horizon {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		height: clamp(120px, 20vh, 220px);
	}

	.dune {
		transition: fill 420ms ease;
	}

	.dune-back {
		fill: var(--dune-back);
	}

	.dune-front {
		fill: var(--dune-front);
	}

	.prince-bg {
		position: absolute;
		right: clamp(-24px, 1vw, 24px);
		bottom: clamp(0px, 4vh, 48px);
		width: clamp(240px, 30vw, 480px);
		height: auto;
		opacity: 0.94;
		filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.16));
		animation: princeFloat 7s ease-in-out infinite;
	}

	@keyframes princeFloat {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-10px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.star,
		.prince-bg {
			animation: none;
		}
	}
</style>
