---
const {
	title = 'Portfolio | Astro',
	description = 'Portfolio moderne, interactif et fluide construit avec Astro.',
} = Astro.props;
const pageLocale = Astro.currentLocale ?? 'fr';
---

<!doctype html>
<html lang={pageLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f5f1ea" />
		<link rel="icon" type="image/webp" href="/github-progile.webp" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<script is:inline>
			const storedTheme = localStorage.getItem('theme');
			const preferredDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const theme = storedTheme ?? (preferredDark ? 'dark' : 'light');
			document.documentElement.dataset.theme = theme;
			document.documentElement.style.colorScheme = theme;
		</script>
	</head>
	<body>
		<div class="page-shell">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--bg: #f6f1ea;
		--bg-top: #f7f2eb;
		--bg-mid: #f3eee6;
		--bg-bottom: #ece6dc;
		--grid-line: rgba(15, 23, 42, 0.05);
		--halo-a: rgba(14, 165, 233, 0.12);
		--halo-b: rgba(192, 132, 252, 0.1);
		--halo-c: rgba(180, 83, 9, 0.08);
		--bg-elevated: rgba(255, 255, 255, 0.74);
		--surface: rgba(255, 255, 255, 0.82);
		--surface-strong: rgba(255, 255, 255, 0.98);
		--border: rgba(15, 23, 42, 0.1);
		--border-strong: rgba(15, 23, 42, 0.18);
		--text: #0f172a;
		--muted: #52627c;
		--accent: #0ea5e9;
		--accent-2: #c084fc;
		--accent-3: #b45309;
		--button-primary-text: #071120;
		--shadow: 0 24px 60px rgba(15, 23, 42, 0.08);
	}

	:root[data-theme='dark'] {
		color-scheme: dark;
		--bg: #081120;
		--bg-top: #081120;
		--bg-mid: #091425;
		--bg-bottom: #050916;
		--grid-line: rgba(255, 255, 255, 0.035);
		--halo-a: rgba(120, 228, 255, 0.2);
		--halo-b: rgba(243, 167, 255, 0.18);
		--halo-c: rgba(255, 214, 110, 0.12);
		--bg-elevated: rgba(9, 16, 31, 0.72);
		--surface: rgba(14, 24, 43, 0.82);
		--surface-strong: rgba(19, 31, 55, 0.98);
		--border: rgba(159, 178, 214, 0.16);
		--border-strong: rgba(159, 178, 214, 0.28);
		--text: #edf4ff;
		--muted: #a7b6d7;
		--accent: #78e4ff;
		--accent-2: #f3a7ff;
		--accent-3: #ffd66e;
		--button-primary-text: #071120;
		--shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background:
			radial-gradient(circle at 18% 12%, var(--halo-a), transparent 24%),
			radial-gradient(circle at 82% 18%, var(--halo-b), transparent 22%),
			radial-gradient(circle at 50% 115%, var(--halo-c), transparent 24%),
			linear-gradient(180deg, var(--bg-top) 0%, var(--bg-mid) 45%, var(--bg-bottom) 100%);
		color: var(--text);
		font-family: 'Manrope', system-ui, sans-serif;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		pointer-events: none;
		background-image: linear-gradient(var(--grid-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
		background-size: 72px 72px;
		mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.5), transparent 90%);
		opacity: 0.45;
	}

	body::after {
		content: '';
		position: fixed;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(circle at center, transparent 45%, rgba(15, 23, 42, 0.08));
	}

	* {
		box-sizing: border-box;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img,
	picture,
	video,
	canvas,
	svg {
		display: block;
		max-width: 100%;
	}

	button,
	input,
	textarea,
	select {
		font: inherit;
	}

	h1,
	h2,
	h3,
	h4 {
		font-family: 'Fraunces', Georgia, serif;
		font-weight: 700;
		letter-spacing: -0.04em;
		margin: 0;
	}

	p {
		margin: 0;
	}

	::selection {
		background: rgba(120, 228, 255, 0.28);
		color: var(--text);
	}

	:focus-visible {
		outline: 2px solid rgba(120, 228, 255, 0.8);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>