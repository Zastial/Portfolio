---
import { getLangFromUrl } from '../i18n/utils';
import Stars from '../components/Stars.astro';

const {
	title = 'Portfolio',
	description = 'Professional portfolio',
} = Astro.props;
const pageLocale = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={pageLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f6e6c8" />
		<link rel="icon" type="image/webp" href="/github-progile.webp" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,600&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<script is:inline>
			const storedTheme = localStorage.getItem('theme');
			const preferredDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const theme = storedTheme ?? (preferredDark ? 'dark' : 'light');
			document.documentElement.dataset.theme = theme;
			document.documentElement.style.colorScheme = theme;
		</script>
	</head>
	<body>
		<Stars />
		<div class="page-shell">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	/* "Crépuscule du désert" — inspired by the aviator's sunset landing in Le Petit Prince */
	:root {
		color-scheme: light;
		--bg: #f6e6c8;
		--bg-top: #fdf1dc;
		--bg-mid: #f7dfc0;
		--bg-bottom: #ecc79b;
		--grid-line: rgba(60, 42, 20, 0.035);
		--halo-a: rgba(74, 127, 165, 0.1);
		--halo-b: rgba(216, 130, 156, 0.12);
		--halo-c: rgba(216, 155, 61, 0.14);
		--bg-elevated: rgba(255, 251, 240, 0.76);
		--surface: rgba(255, 251, 241, 0.82);
		--surface-strong: rgba(255, 253, 246, 0.98);
		--border: rgba(63, 44, 20, 0.12);
		--border-strong: rgba(63, 44, 20, 0.22);
		--text: #2c2013;
		--muted: #6c5a44;
		--accent: #c98a2c;
		--accent-2: #c9648a;
		--accent-3: #3f6f8f;
		--button-primary-text: #2c1a04;
		--shadow: 0 24px 60px rgba(90, 60, 20, 0.14);
		--star-color: #b9832f;
		--stars-opacity: 0.22;
		--dune-back: #e9c797;
		--dune-front: #dcb17f;
	}

	/* "Nuit étoilée" — the little prince's sky, far from the lamplighter's planet */
	:root[data-theme='dark'] {
		color-scheme: dark;
		--bg: #080b22;
		--bg-top: #0a0e2c;
		--bg-mid: #0d1440;
		--bg-bottom: #05070f;
		--grid-line: rgba(244, 201, 93, 0.03);
		--halo-a: rgba(126, 200, 227, 0.12);
		--halo-b: rgba(242, 166, 193, 0.1);
		--halo-c: rgba(244, 201, 93, 0.1);
		--bg-elevated: rgba(11, 15, 41, 0.72);
		--surface: rgba(14, 19, 48, 0.78);
		--surface-strong: rgba(18, 24, 58, 0.97);
		--border: rgba(244, 201, 93, 0.16);
		--border-strong: rgba(244, 201, 93, 0.3);
		--text: #f6f0ff;
		--muted: #aab0d9;
		--accent: #f4c95d;
		--accent-2: #f2a6c1;
		--accent-3: #7ec8e3;
		--button-primary-text: #201200;
		--shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
		--star-color: #f7ecc9;
		--stars-opacity: 0.9;
		--dune-back: #0b1030;
		--dune-front: #060a20;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background:
			radial-gradient(circle at 18% 12%, var(--halo-a), transparent 24%),
			radial-gradient(circle at 82% 18%, var(--halo-b), transparent 22%),
			radial-gradient(circle at 50% 115%, var(--halo-c), transparent 24%),
			linear-gradient(180deg, var(--bg-top) 0%, var(--bg-mid) 45%, var(--bg-bottom) 100%);
		background-attachment: fixed;
		color: var(--text);
		font-family: 'Manrope', system-ui, sans-serif;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
		transition: background-color 420ms ease, color 420ms ease;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		pointer-events: none;
		background-image: radial-gradient(var(--grid-line) 1.2px, transparent 1.2px);
		background-size: 26px 26px;
		mask-image: radial-gradient(circle at 50% 20%, rgba(0, 0, 0, 0.55), transparent 75%);
		opacity: 0.6;
	}

	body::after {
		content: '';
		position: fixed;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(circle at center, transparent 45%, rgba(15, 12, 5, 0.05));
	}

	* {
		box-sizing: border-box;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img,
	picture,
	video,
	canvas,
	svg {
		display: block;
		max-width: 100%;
	}

	button,
	input,
	textarea,
	select {
		font: inherit;
	}

	h1,
	h2,
	h3,
	h4 {
		font-family: 'Fraunces', Georgia, serif;
		font-weight: 700;
		letter-spacing: -0.04em;
		margin: 0;
	}

	p {
		margin: 0;
	}

	::selection {
		background: color-mix(in srgb, var(--accent) 35%, transparent);
		color: var(--text);
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>